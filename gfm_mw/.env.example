# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production        # development | staging | production
PORT=3000
LOG_LEVEL=info             # debug in dev only

# ── Database ──────────────────────────────────────────────────────────────────
# Dev: set DATABASE_URL directly.
# Prod (docker-compose.prod.yml): set the three POSTGRES_* vars below; the
# compose file assembles DATABASE_URL from them automatically.
DATABASE_URL=postgres://gfm:gfm@localhost:5432/gfm

POSTGRES_DB=gfm
POSTGRES_USER=gfm
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ─────────────────────────────────────────────────────────────────────
# Dev: no password required.
# Prod (docker-compose.prod.yml): set REDIS_PASSWORD; REDIS_URL is built automatically.
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ── Google auth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# ── AI provider ───────────────────────────────────────────────────────────────
# Selects which backend serves /ai/generate. Options: gemini | openrouter
# Wire-level error codes returned to Flutter remain `gemini_*` regardless.
AI_PROVIDER=gemini

# Required when AI_PROVIDER=gemini.
GEMINI_API_KEY=<your-gemini-api-key>

# ── OpenRouter (alternative provider) ─────────────────────────────────────────
# Required when AI_PROVIDER=openrouter. Get a key at https://openrouter.ai/keys
# Model defaults to a free Gemini-flash; pick anything from
# https://openrouter.ai/models that supports JSON output.
# Note: OpenRouter only handles text/urls input types reliably — pdf/book/youtube
# attachments are dropped with a warning since most OR models do not accept
# inline binary or fileData parts.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ── RevenueCat ────────────────────────────────────────────────────────────────
RC_WEBHOOK_SECRET=<shared-secret-from-rc-dashboard>

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Observability ─────────────────────────────────────────────────────────────
# Required — 32+ hex chars; gate for /health and /metrics
HEALTH_TOKEN=<generate-with: openssl rand -hex 32>

# ── Kill switches ─────────────────────────────────────────────────────────────
AI_GENERATION_DISABLED=false
MAX_DAILY_GEMINI_SPEND_USD=10
USER_DENYLIST=

# ── Rate limits (requests per window; defaults from rate-limiting-abuse.md §4.1) ──
RL_AI_GLOBAL_HOURLY=300
RL_AI_IP_HOURLY=30
RL_AI_USER_HOURLY=10
RL_AI_USER_DAILY=50
RL_STATUS_USER_MIN=60
RL_RC_IP_MIN=120
RL_DEFAULT_IP_MIN=120

# ── Cost circuit breaker ──────────────────────────────────────────────────────
MAX_USER_DAILY_GEMINI_USD=0.50

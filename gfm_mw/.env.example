# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://gfm:gfm@localhost:5432/gfm

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Google auth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=<your-gemini-api-key>

# ── RevenueCat ────────────────────────────────────────────────────────────────
RC_WEBHOOK_SECRET=<shared-secret-from-rc-dashboard>

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Observability ─────────────────────────────────────────────────────────────
# Required — 32+ hex chars; gate for /health and /metrics
HEALTH_TOKEN=<generate-with: openssl rand -hex 32>

# ── Kill switches ─────────────────────────────────────────────────────────────
AI_GENERATION_DISABLED=false
MAX_DAILY_GEMINI_SPEND_USD=10
USER_DENYLIST=

# ── Rate limits (requests per window; defaults from rate-limiting-abuse.md §4.1) ──
RL_AI_GLOBAL_HOURLY=300
RL_AI_IP_HOURLY=30
RL_AI_USER_HOURLY=10
RL_AI_USER_DAILY=50
RL_STATUS_USER_MIN=60
RL_RC_IP_MIN=120
RL_DEFAULT_IP_MIN=120

# ── Cost circuit breaker ──────────────────────────────────────────────────────
MAX_USER_DAILY_GEMINI_USD=0.50
